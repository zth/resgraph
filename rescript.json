{
  "name": "resgraph",
  "version": "1.0.0",
  "uncurried": true,
  "sources": [
    {
      "dir": "cli",
      "subdirs": true,
      "dev": true
    },
    {
      "dir": "src/res",
      "subdirs": true
    }
  ],
  "package-specs": [
    {
      "module": "esmodule",
      "in-source": true,
      "suffix": ".mjs"
    },
    {
      "module": "commonjs",
      "in-source": true,
      "suffix": ".js"
    }
  ],
  "dependencies": ["rescript-nodejs", "@glennsl/rescript-fetch"],
  "compiler-flags": ["-open NodeJs"]
}
